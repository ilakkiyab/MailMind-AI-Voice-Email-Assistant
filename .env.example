# Copy this file to .env and provide your own local values.
# Never commit .env or credential files.

# Phase 3: downloaded Google OAuth Desktop app JSON (not a Gmail password).
# Place credentials.json beside app.py. OAuth saves token.json there automatically.
DATABASE_PATH=data/email_assistant.db

# Phase 2B NVIDIA NIM email drafting (keep real credentials in .env only).
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
